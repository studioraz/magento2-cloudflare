<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <srcloudflare>
            <general>
                <active>0</active>
                <image_quality>85</image_quality>
                <image_fit>none</image_fit>
            </general>
            <cache>
                <active>0</active>
                <debug>0</debug>
                <api_url>https://api.cloudflare.com/client/v4/zones/%s/purge_cache</api_url>
                <api_token backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <zone_selection>all</zone_selection>
                <async_purge>1</async_purge>
                <purge_batch_size>100</purge_batch_size>
                <purge_max_requests_per_cron>25</purge_max_requests_per_cron>
                <purge_max_attempts>10</purge_max_attempts>
            </cache>

            <worker>
                <name>magento-fpc</name>
                <debug>0</debug>
                <hfp_ttl>120</hfp_ttl>
                <bypass_paths/>
            </worker>

            <worker_routes>
                <bypass_paths/>
            </worker_routes>
        </srcloudflare>
    </default>
</config>
